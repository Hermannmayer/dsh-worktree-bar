{
  "name": "dsh-worktree-bar",
  "version": "0.1.0",
  "description": "Workspace and branch status above the composer, a start-screen git worktree checkbox, and per-project worktree preparation — for the DeepSeek Harness Web UI.",
  "type": "module",
  "main": "./lib/plugin.js",
  "license": "MIT",
  "author": "Hermannmayer",
  "homepage": "https://github.com/Hermannmayer/dsh-worktree-bar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hermannmayer/dsh-worktree-bar.git"
  },
  "bugs": {
    "url": "https://github.com/Hermannmayer/dsh-worktree-bar/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1 <0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.7-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "worktree",
    "git",
    "plugin"
  ],
  "scripts": {
    "test": "node test/git.test.mjs && node test/seed.test.mjs && node test/host.test.mjs && node test/client.test.mjs",
    "check": "node --check lib/plugin.js && node --check client.js && node --check lib/git.js"
  },
  "meta": {
    "title": "Worktree",
    "description": "Shows the workspace and branch above the composer, and starts a session in an isolated git worktree."
  },
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./client.js",
    "./git": "./lib/git.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": true,
    "apiKeys": [],
    "permissions": [
      "filesystem: create and remove git worktrees inside the repository",
      "filesystem: append the worktree paths to .git/info/exclude",
      "process: run git with argument arrays, no shell",
      "process: run the project's own setup command when dsh-worktree.json declares one",
      "os: reveal a directory, open a terminal, or open a URL, only on a click"
    ],
    "jurisdiction": [],
    "retention": "none"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "test/*.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  }
}
